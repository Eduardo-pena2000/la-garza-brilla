{
  "rules": {
    "users": {
      "$userId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['id', 'email', 'name']) && !newData.hasChild('password')"
      }
    },
    "mesas": {
      ".read": true,
      "$mesaId": {
        ".write": true,
        "players": {
          ".indexOn": ["role", "status"]
        }
      },
      ".indexOn": ["status", "createdAt", "isVip"]
    }
  }
}
