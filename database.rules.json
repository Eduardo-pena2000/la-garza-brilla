{
  "rules": {
    "users": {
      "$userId": {
        ".read": true,
        ".write": true
      }
    },
    "mesas": {
      ".read": true,
      "$mesaId": {
        ".write": true,
        "players": {
          ".indexOn": ["role", "status"]
        }
      },
      ".indexOn": ["status", "createdAt", "isVip"]
    }
  }
}
